{
  "name": "betterdesk-console",
  "version": "3.5.4",
  "description": "BetterDesk Console - Professional Web Management Panel for BetterDesk Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:ci": "jest --detectOpenHandles --forceExit --ci",
    "i18n:check": "node scripts/i18n-check.js --system web-nodejs",
    "i18n:check:all": "node scripts/i18n-check.js",
    "i18n:commercialization": "node scripts/patch-commercialization-i18n.js",
    "i18n:updates-docker": "node scripts/patch-updates-docker-i18n.js",
    "prei18n:check": "npm run i18n:commercialization && npm run i18n:updates-docker",
    "i18n:apply": "node scripts/dev-i18n/apply-i18n-audit.js",
    "i18n:gap-collect": "node scripts/dev-i18n/collect-gap-keys.js",
    "i18n:gap-generate": "node scripts/dev-i18n/generate-gap-fill.js"
  },
  "keywords": [
    "rustdesk",
    "betterdesk",
    "remote-desktop",
    "management-console"
  ],
  "author": "UNITRONIX",
  "license": "AGPL-3.0",
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "otplib": "^13.5.0",
    "protobufjs": "^7.6.5",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0",
    "pg": "^8.23.1"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "js-yaml": "^3.15.0",
    "tar": "^7.5.21",
    "path-to-regexp": "^0.1.13",
    "brace-expansion": "^5.0.8",
    "form-data": "^4.0.6",
    "body-parser": "^1.20.6",
    "protobufjs": "^7.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
