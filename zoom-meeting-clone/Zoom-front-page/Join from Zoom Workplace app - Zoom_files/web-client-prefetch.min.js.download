// Add <link rel="prefetch" href="cdn.zoom.com/main-web-client.min.css"> for prefetching assets
// RFC: https://zoomvideo.atlassian.net/wiki/spaces/~6278bc1023d61e006fc3a01b/pages/2464973276/Request+For+Comments+Doc+User+Experience+Optimization+for+web-client#:~:text=Prefetch%20and%20Preload

try {
(function(data) {
  /*
  window.MeetingConfig?.cdnPath value examples:
  - Dev: 'https://d27xp8zu78jmsf.cloudfront.net/web_client/dtm4l1m'
  - Prod: 'https://st1.zoom.us/web_client/gg8er8m'

  Backend src code: https://git.zoom.us/web/web/-/blob/release/web-main/src/main/webapp/WEB-INF/ftl/webclient/wc_meeting_v2.ftl#L307
  */
  const CDN_HOST = window?.webclientCDNPath || window?.MeetingConfig?.cdnPath
  if (!data?.length || !CDN_HOST) {
    return
  }

  function addPrefetchTag(src) {
    const tag = document.createElement('link')
    tag.rel = 'prefetch'
    tag.href = src
    // enable crossorigin to make sure prefetch cache works for
    // web-client Cross Origin Isolation status(COEP: credentialess).
    // tag.setAttribute('crossorigin', 'anonymous')
    /* 2024-01 update: Not set crossorigin attr,
    so that when launch page join WebClient redirect from https://zoom.us to https://*.zoom.us ,
    prefetch cache can work.
    */
    const head = document.querySelector('head')
    if (head?.appendChild) {
      head.appendChild(tag)
    }
  }

  data?.forEach(src => {
    if (src) {
      addPrefetchTag(CDN_HOST + src)
    }
  })
})([
  '/js/vendor/externals.min.js','/js/webclient.min.js','/css/styles.wc_meeting.min.css',
  //eg: '/js/main-client.webclient.min.js',
])
} catch (err) {
  console.log(`web-client-prefetch.js ERROR: err=${err}`)
}
