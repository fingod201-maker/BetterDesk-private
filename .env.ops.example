# BetterDesk 24/7 Production Environment
# Copy to .env.ops and fill in values before deploying.
#
# Required:
#   CERTBOT_EMAIL       — Let's Encrypt account email (receives expiry notices)
#   RELAY_PUBLIC_IP     — Public IP of this server (clients relay through it)
#   SESSION_SECRET      — 32+ random hex chars for web session encryption
#
# Optional:
#   STAGING             — Set to "1" to use Let's Encrypt staging (test certs)
#   ADMIN_USERNAME      — Initial admin login (default: admin)
#   ADMIN_PASSWORD      — Initial admin password (12+ chars)
#   PG_PASSWORD         — Only if using PostgreSQL (DB_TYPE=postgres)

CERTBOT_EMAIL=admin@telcom.stream
RELAY_PUBLIC_IP=YOUR.PUBLIC.IP
SESSION_SECRET=
STAGING=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DB_TYPE=sqlite
PG_PASSWORD=
